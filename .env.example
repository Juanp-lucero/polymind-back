# Base de datos y autenticacion
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/polymind
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq: genera el informe narrativo del analisis multiagente
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Despliegue (Vercel)
# Orígenes permitidos para CORS, separados por coma (URL del frontend)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# remote = usa el servidor gRPC en GRPC_SERVER_ADDRESS; inprocess = mismo proceso (por defecto en Vercel)
GRPC_MODE=remote
GRPC_SERVER_ADDRESS=localhost:50051
